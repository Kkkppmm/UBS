{
  "name": "community-api",
  "version": "1.0.0",
  "private": true,
  "description": "USBForge Companion cloud API (auth, posts, feedback, updates)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute usbforge-community --remote --file=./schema.sql",
    "db:migrate:local": "wrangler d1 execute usbforge-community --local --file=./schema.sql"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260730.1",
    "typescript": "^7.0.2",
    "wrangler": "^4.116.0"
  }
}
