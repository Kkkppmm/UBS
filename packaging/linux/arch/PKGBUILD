# Maintainer: USBForge Contributors
pkgname=usbforge
pkgver=1.5.0
pkgrel=1
pkgdesc="Bootable ISO builder and Live USB Lab"
arch=('x86_64')
url="https://github.com/Kkkppmm/UBS"
license=('MIT')
depends=('gtk3' 'xorriso')
optdepends=('grub: ISO bootloader packaging' 'mtools: hybrid ISO helpers' 'curl: updater')
makedepends=('gcc' 'make' 'pkgconf')
source=("$pkgname-$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
  cd "$pkgname-$pkgver"
  make
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 build/usbforge-builder "$pkgdir/usr/bin/usbforge-builder"
  install -Dm755 build/usbforge-live "$pkgdir/usr/bin/usbforge-live"
  install -Dm755 scripts/usbforge-update.sh "$pkgdir/usr/bin/usbforge-update"
  install -Dm644 docs/* -t "$pkgdir/usr/share/usbforge/docs/"
  install -Dm755 scripts/build-iso.sh "$pkgdir/usr/share/usbforge/scripts/build-iso.sh"
  install -Dm755 scripts/write-media.sh "$pkgdir/usr/share/usbforge/scripts/write-media.sh"
  install -Dm755 scripts/live-autostart.sh "$pkgdir/usr/share/usbforge/scripts/live-autostart.sh"
  install -Dm644 packaging/linux/usbforge-builder.desktop "$pkgdir/usr/share/applications/usbforge-builder.desktop"
  install -Dm644 packaging/linux/usbforge-live.desktop "$pkgdir/usr/share/applications/usbforge-live.desktop"
  cp -a packaging/linux/icons/hicolor "$pkgdir/usr/share/icons/"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
